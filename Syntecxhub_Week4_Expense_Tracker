# ─── Paths & constants ────────────────────────────────────────────────────────

BASE_DIR  = Path(__file__).parent
DB_PATH   = BASE_DIR / "expenses.db"
LOG_PATH  = BASE_DIR / "tracker.log"

CATEGORIES = [
    "Food", "Transport", "Housing", "Utilities", "Entertainment",
    "Healthcare", "Education", "Shopping", "Salary", "Freelance",
    "Investment", "Other",
]

INCOME_CATS  = {"Salary", "Freelance", "Investment"}
EXPENSE_CATS = set(CATEGORIES) - INCOME_CATS

