def main():
    parser = build_parser()
    args   = parser.parse_args()
    conn   = init_db()

    try:
        dispatch = {
            "add":     lambda: cmd_add(args, conn),
            "list":    lambda: cmd_list(args, conn),
            "summary": lambda: cmd_summary(args, conn),
            "export":  lambda: cmd_export(args, conn),
            "chart":   lambda: cmd_chart(args, conn),
            "delete":  lambda: cmd_delete(args, conn),
            "stats":   lambda: cmd_stats(conn),
        }
        dispatch[args.command]()
    finally:
        conn.close()


if __name__ == "__main__":
    main()
